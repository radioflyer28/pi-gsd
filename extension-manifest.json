{
  "id": "pi-gsd",
  "name": "pi-gsd",
  "version": "0.3.0",
  "description": "Thin Pi adapter for upstream GSD Core with optional context-mode and pi-subagents awareness.",
  "tier": "community",
  "requires": {
    "platform": ">=2.29.0"
  },
  "provides": {
    "tools": [
      "gsd"
    ],
    "commands": [
      "gsd-status",
      "gsd-doctor",
      "gsd-run",
      "gsd-model",
      "gsd-model-config",
      "gsd-init-config",
      "gsd-*"
    ]
  }
}
