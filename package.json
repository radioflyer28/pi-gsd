{
  "name": "pi-gsd",
  "version": "0.1.0",
  "description": "Pi extension wrapper for @opengsd/gsd-core with optional pi-subagents and context-mode awareness.",
  "type": "module",
  "license": "MIT",
  "private": true,
  "scripts": {
    "typecheck": "tsc --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json",
    "check": "npm run typecheck && npm run typecheck:test",
    "build": "tsc -p tsconfig.build.json",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:live-pi": "node scripts/live-pi-rpc-smoke.mjs"
  },
  "keywords": [
    "pi-package",
    "pi",
    "gsd",
    "opengsd",
    "context-engineering",
    "spec-driven-development"
  ],
  "pi": {
    "extensions": [
      "./src/extension/index.ts"
    ],
    "skills": [
      "./skills"
    ],
    "prompts": [
      "./prompts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "dependencies": {
    "@opengsd/gsd-core": ">=1.3.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
