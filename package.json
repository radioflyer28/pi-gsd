{
  "name": "pi-gsd",
  "version": "0.2.0",
  "description": "Pi extension wrapper for @opengsd/gsd-core with optional pi-subagents and context-mode awareness.",
  "type": "module",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/radioflyer28/pi-gsd.git"
  },
  "homepage": "https://github.com/radioflyer28/pi-gsd#readme",
  "bugs": {
    "url": "https://github.com/radioflyer28/pi-gsd/issues"
  },
  "files": [
    "src",
    "prompts",
    "docs",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "extension-manifest.json"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json",
    "check": "npm run typecheck && npm run typecheck:test",
    "build": "tsc -p tsconfig.build.json",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:live-pi": "node scripts/live-pi-rpc-smoke.mjs",
    "test:live-subagent": "node scripts/live-subagent-routing-smoke.mjs",
    "release:check": "node scripts/validate-release.mjs"
  },
  "keywords": [
    "pi-package",
    "pi",
    "gsd",
    "opengsd",
    "context-engineering",
    "spec-driven-development"
  ],
  "pi": {
    "extensions": [
      "./src/extension/index.ts"
    ],
    "prompts": [
      "./prompts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "dependencies": {
    "@opengsd/gsd-core": "^1.10.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
